# Node / proxy
AGENT_SERVICE_URL=http://127.0.0.1:8770

# Python / OpenAI-compatible model
OPENAI_API_KEY=
# 当前示例提供商: DeepSeek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_TEMPERATURE=0.2
# leave blank for providers that do not support them.
OPENAI_REASONING_EFFORT=low
OPENAI_THINKING_TYPE=disabled
AGENT_RUN_TIMEOUT_SECONDS=900
AGENT_LLM_TIMEOUT_SECONDS=180
